// Device signing. The simulator needs none; a real iPhone needs a team.
//
// THE PROJECT'S OWN TEAM (JARED MATHEW KROSSER, QZF43AV37Q) is committed in
// project.yml's base settings, so every generated target carries it and a
// fresh clone — Xcode Cloud included — signs identically to this machine.
//
// To sign with a DIFFERENT Apple ID, override it locally and untracked:
//
//     echo 'DEVELOPMENT_TEAM = ABCDE12345' > ios/Local.xcconfig
//
// Find the ID in Xcode ▸ Settings ▸ Accounts ▸ (your Apple ID) ▸ Manage
// Certificates, or at developer.apple.com/account under Membership details.
// A free Apple ID works — apps just expire after 7 days.
#include? "Local.xcconfig"
